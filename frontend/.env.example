# Copy to .env in frontend/. Never commit real credentials.
DATABASE_URL=postgresql://qazloyal:CHANGE_ME@localhost:5432/qazloyal_dev?schema=public
TEST_DATABASE_URL=postgresql://qazloyal:CHANGE_ME@localhost:5432/qazloyal_test?schema=public
# Generate at least 32 random characters for the session HMAC key.
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BLOCKCHAIN_ENABLED=false
# Development seed opt-in. Never enable in a pilot or production database.
ALLOW_DEV_SEED=false
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# v0.4: production must use HTTPS and a configured email provider.
# Development/test only: console prints action links. Never use console in production.
EMAIL_PROVIDER=console
# Production adapter: resend. Verify a sending domain with your provider.
EMAIL_FROM=
EMAIL_API_KEY=
# Optional alias, if set must match NEXT_PUBLIC_APP_URL.
APP_URL=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
# For pooling: use provider's transaction-pool URL at runtime, direct URL for migrations.
# Add connect_timeout=5 and pool_timeout=5 to the runtime DATABASE_URL as appropriate.

# Optional legacy blockchain public configuration (leave addresses empty while disabled).
NEXT_PUBLIC_LEGACY_QFC_ADDRESS=
NEXT_PUBLIC_QRAFT_PAYMENT_ADDRESS=
NEXT_PUBLIC_REQUIRED_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=Sepolia
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_LEGACY_PAYMENT_CODE_HASH=

# Separate random 32+ character HMAC secret (required in production).
RATE_LIMIT_SECRET=
# netlify on Netlify; trusted-proxy only behind a locked-down proxy overwriting X-Real-IP.
TRUSTED_PROXY=none
NODE_ENV=development
