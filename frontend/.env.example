# QazLoyal pilot: safe template only. Set real values in Netlify environment settings.
# Required launch settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://YOUR_PROJECT.netlify.app
APP_URL=https://YOUR_PROJECT.netlify.app

# Database: Neon pooled runtime connection. Use direct URL only for migrate deploy.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_ENDPOINT-pooler.neon.tech/qazloyal?sslmode=require&connect_timeout=10&pool_timeout=10

# Authentication/session: independent cryptographically random secrets, 32+ bytes each.
AUTH_SECRET=
RATE_LIMIT_SECRET=

# Email: disabled for core pilot; set resend and real sender/key to enable email.
EMAIL_PROVIDER=disabled
EMAIL_FROM=onboarding@resend.dev
EMAIL_API_KEY=

# Pilot safety settings
TRUSTED_PROXY=netlify
BLOCKCHAIN_ENABLED=false
ALLOW_DEV_SEED=false

# Optional legacy public values (unused while blockchain is disabled)
NEXT_PUBLIC_LEGACY_QFC_ADDRESS=
NEXT_PUBLIC_QFC_ADDRESS=
NEXT_PUBLIC_QFT_ADDRESS=
NEXT_PUBLIC_QRAFT_PAYMENT_ADDRESS=
NEXT_PUBLIC_REQUIRED_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=Sepolia
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_LEGACY_PAYMENT_CODE_HASH=

# Local development/tests ONLY. Do not install these in Netlify production.
# For local dev set NODE_ENV=development, EMAIL_PROVIDER=console and localhost APP URLs.
TEST_DATABASE_URL=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
