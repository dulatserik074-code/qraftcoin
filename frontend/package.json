{
  "name": "qazloyal-frontend",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --experimental-strip-types scripts/start.mjs",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "test:integration": "node scripts/integration.mjs",
    "postinstall": "prisma generate",
    "db:cleanup": "node scripts/cleanup.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "ethers": "^6.15.0",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "description": "QazLoyal — digital loyalty platform for small and medium businesses",
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "postcss": "8.5.28",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.2"
    }
  }
}

